#!/data/data/com.termux/files/usr/bin/bash
# Goal-driven LinkedIn invitation withdrawal
# Uses DeepSeek AI (from resume-forge-ai) for intelligent screen classification
# Falls back to OCR keyword matching when AI is unavailable
set -o pipefail

SU=/debug_ramdisk/su
STOP_FLAG="/data/local/tmp/linkedin-stop-flag"
LOG="/sdcard/linkedin-debug.log"
SS="/sdcard/li_ss.png"
TESSDATA="$PREFIX/share/tessdata"
MAX=50
MAX_UNKNOWN=8
TSX_WRAPPER=~/bin/tsx
AI_SCRIPT="/data/data/com.termux/files/home/linkedin-android/ai/analyze.ts"
DEEPSEEK_TOKEN="${DEEPSEEK_TOKEN:-}"

log() { echo "$(date +%H:%M:%S) $*" >> "$LOG"; }

check_stop() {
  if [ -f "$STOP_FLAG" ]; then
    log "STOP"; rm -f "$STOP_FLAG"; exit 0
  fi
}

cleanup() { rm -f /sdcard/li_ss.png; }
trap cleanup EXIT
trap 'log "SIGTERM/SIGINT"; exit 0' TERM INT

su_sys() {
  check_stop
  $SU -c "unset LD_LIBRARY_PATH LD_PRELOAD; PATH=/debug_ramdisk:/sbin:/system/bin:/system/xbin $*" 2>/dev/null
}

ss() { su_sys "screencap -p $SS"; }

ocr_tsv() {
  TESSDATA_PREFIX=$TESSDATA tesseract "$SS" stdout -l eng tsv 2>/dev/null
}

ocr_text() {
  TESSDATA_PREFIX=$TESSDATA tesseract "$SS" stdout -l eng 2>/dev/null
}

find_word() {
  local word="$1" min_conf="${2:-30}"
  ocr_tsv | awk -F'\t' -v w="$word" -v mc="$min_conf" '
    NR>1 && $11+0 > mc && tolower($12) ~ tolower(w) { print $7, $8, $9, $10, $11, $12; exit }
  '
}

find_all_words() {
  local word="$1" min_conf="${2:-30}"
  ocr_tsv | awk -F'\t' -v w="$word" -v mc="$min_conf" '
    NR>1 && $11+0 > mc && tolower($12) ~ tolower(w) { print $7, $8, $9, $10, $11, $12 }
  '
}

tap_bbox() { su_sys "input tap $(($1 + $3 / 2)) $(($2 + $4 / 2))"; }
tap_at() { su_sys "input tap $1 $2"; }
tap_back() { su_sys "input keyevent KEYCODE_BACK"; }
swipe_down() { su_sys "input swipe 540 1800 540 400 200"; }
swipe_up() { su_sys "input swipe 540 400 540 1400 300"; }

# ─── AI screen classifier (DeepSeek) ────────────────────────────

ai_ready() {
  [ -n "$DEEPSEEK_TOKEN" ] && [ -f "$TSX_WRAPPER" ] && [ -f "$AI_SCRIPT" ]
}

detect_screen_ai() {
  ss || { echo "ERROR"; return; }
  local text
  text=$(ocr_text | tr '\n' ' ' | tr -s ' ')
  log "OCR: $text"
  local result
  result=$(DEEPSEEK_TOKEN="$DEEPSEEK_TOKEN" \
    WASM_PATH="/data/data/com.termux/files/home/resume-forge-ai/lib/ai/wasm/sha3_wasm_bg.wasm" \
    "$TSX_WRAPPER" "$AI_SCRIPT" "$text" 2>>"$LOG")
  log "AI: $result"
  local screen
  screen=$(echo "$result" | grep "^SCREEN:" | sed 's/^SCREEN: *//' | tr '[:lower:]' '[:upper:]')
  echo "${screen:-UNKNOWN}"
}

# ─── Fallback OCR screen classifier ────────────────────────────

detect_screen_ocr() {
  ss || { echo "ERROR"; return; }
  local lower
  lower=$(ocr_text | tr '[:upper:]' '[:lower:]')

  [[ "$lower" == *"invitations sent"* ]] && { echo "SENT_LIST";      return; }
  [[ "$lower" == *"invitations received"* ]] && { echo "RECEIVED_LIST";  return; }
  [[ "$lower" == *"are you sure"* ]] && { echo "CONFIRM";        return; }
  [[ "$lower" == *"withdraw this"* ]] && { echo "CONFIRM";        return; }
  [[ "$lower" == *"cancel"* ]] && [[ "$lower" == *"withdraw"* ]] && { echo "CONFIRM"; return; }
  [[ "$lower" == *"withdraw"* ]] && { echo "HAS_WITHDRAW";   return; }
  [[ "$lower" == *"no pending"* ]] && { echo "EMPTY";        return; }
  [[ "$lower" == *"manage"* ]] && { echo "MANAGE";         return; }
  [[ "$lower" == *"start a post"* ]] && { echo "FEED";           return; }
  [[ "$lower" == *"people you may know"* ]] && { echo "MY_NETWORK";     return; }
  echo "UNKNOWN"
}

detect_screen() {
  local s
  if ai_ready; then
    s=$(detect_screen_ai)
    [ "$s" != "UNKNOWN" ] && [ "$s" != "ERROR" ] && { echo "$s"; return; }
    log "AI returned $s, falling back to OCR"
  fi
  detect_screen_ocr
}

# ─── Scroll-to-bottom ───────────────────────────────────────────

scroll_to_bottom() {
  local same=0 prev_hash="" h
  ss
  prev_hash=$(md5sum "$SS" 2>/dev/null | cut -d' ' -f1)
  for _ in $(seq 1 40); do
    check_stop
    swipe_down; sleep 0.2; ss
    h=$(md5sum "$SS" 2>/dev/null | cut -d' ' -f1)
    [ "$h" = "$prev_hash" ] && same=$((same + 1)) || same=0
    [ "$same" -ge 3 ] && { log "Bottom reached"; return; }
    prev_hash=$h
  done
}

# ─── Main goal loop ─────────────────────────────────────────────

log "=== AI-GUIDED WITHDRAW ==="
rm -f "$STOP_FLAG"
ai_ready && log "AI mode: enabled" || log "AI mode: disabled (set DEEPSEEK_TOKEN)"

log "Launching LinkedIn..."
su_sys "am start -a android.intent.action.VIEW -d 'https://www.linkedin.com/mynetwork/invitation-manager/' 2>/dev/null"
log "Waiting for LinkedIn..."
sleep 8

log "Checking initial screen..."
first_screen=$(detect_screen)
log "Initial: $first_screen"

count=0
stuck=0
prev_screen=""
last_withdraw_pos=""
back_count=0

while [ "$count" -lt "$MAX" ]; do
  check_stop
  screen=$(detect_screen)
  log "Screen: $screen | withdrawn: $count"

  # Stuck detection
  [ "$screen" = "$prev_screen" ] && stuck=$((stuck + 1)) || stuck=0
  prev_screen=$screen
  if [ "$stuck" -ge 6 ]; then
    log "STUCK on $screen, scrolling up"
    swipe_up; sleep 1.5; stuck=0
  fi

  case "$screen" in

    SENT_LIST|HAS_WITHDRAW)
      buttons=$(find_all_words "Withdraw" 30 | sort -k2 -rn)
      if [ -z "$buttons" ]; then
        log "No Withdraw visible, scrolling"
        for _ in 1 2 3; do check_stop; swipe_down; sleep 0.3; done
        sleep 0.5
        buttons=$(find_all_words "Withdraw" 30 | sort -k2 -rn)
        if [ -z "$buttons" ]; then
          scroll_to_bottom; swipe_up; sleep 0.5
          buttons=$(find_all_words "Withdraw" 30 | sort -k2 -rn)
        fi
        if [ -z "$buttons" ]; then
          log "No Withdraw anywhere — done"
          echo "$count withdrawn"; exit 0
        fi
      fi

      coords=$(echo "$buttons" | sort -k2 -n | head -1)
      read x y ww wh _ _ <<< "$coords"
      cur_pos="${x}_${y}"
      [ "$cur_pos" = "$last_withdraw_pos" ] && {
        log "Same button, scrolling past"; swipe_down; sleep 0.5; continue
      }
      last_withdraw_pos="$cur_pos"

      log "Tapping Withdraw at $x,$y"
      tap_bbox $x $y $ww $wh; sleep 2.5; stuck=0

      subscreen=$(detect_screen)
      if [ "$subscreen" = "CONFIRM" ]; then
        log "Confirm dialog"; tap_at 780 2250; sleep 1.5
        count=$((count + 1)); log "Withdrawn: $count"; last_withdraw_pos=""
      else
        log "No confirm (screen=$subscreen)"
      fi
      ;;

    CONFIRM)
      log "Tapping confirm"; tap_at 780 2250; sleep 1.5
      count=$((count + 1)); log "Withdrawn: $count"
      ;;

    RECEIVED_LIST)
      log "On Received tab, tapping Sent"
      sent=$(find_word "Sent" 30)
      if [ -n "$sent" ]; then
        read sx sy sw sh _ _ <<< "$sent"
        tap_bbox $sx $sy $sw $sh
      else
        tap_at 540 324
      fi
      sleep 2
      ;;

    MANAGE|MY_NETWORK)
      log "On manage page, tapping Sent tab"
      sent=$(find_word "Sent" 30)
      if [ -n "$sent" ]; then
        read sx sy sw sh _ _ <<< "$sent"
        tap_bbox $sx $sy $sw $sh; sleep 2; swipe_down; sleep 0.3
      else
        tap_at 540 324; sleep 1
      fi
      ;;

    FEED)
      log "On feed, tapping My Network"; tap_at 900 120; sleep 3
      ;;

    EMPTY)
      log "No pending invitations"; echo "$count withdrawn"; exit 0
      ;;

    DONE)
      log "AI says done"; echo "$count withdrawn"; exit 0
      ;;

    ESCALATE)
      log "AI escalation — stopping"; exit 1
      ;;

    UNKNOWN)
      log "Unknown — retrying"
      back_count=$((back_count + 1))
      if [ "$back_count" -ge 5 ]; then
        log "UNKNOWN 5×, trying back"; tap_back; sleep 2; back_count=0
      else
        sleep 1
      fi
      ;;

    ERROR)
      log "Screenshot failed, retry"; sleep 2
      ;;
  esac
done

log "Max ($MAX) reached"
echo "$count withdrawn"
